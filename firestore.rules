rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vegas Yolu: her oyuncu yalnızca kendi kaydını okuyup yazabilir.
    // Oyun Worktimer Firebase projesini paylaşır; bu blok o projenin mevcut kurallarına eklenir.
    match /vegasYolu/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
